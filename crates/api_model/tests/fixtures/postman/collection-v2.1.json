{
  "info": {
    "_postman_id": "00000000-0000-4000-8000-000000000001",
    "name": "Users API",
    "description": "A small v2.1 collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "alice", "type": "string" },
      { "key": "password", "value": "password-REDACTED", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": { "type": "text/javascript", "exec": ["console.log('never runs')"] }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://api.example.com", "type": "string" },
    { "key": "apiKey", "value": "token-REDACTED-example", "type": "secret" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"user\":\"alice\"}", "options": { "raw": { "language": "json" } } },
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "token-REDACTED-example", "type": "string" } ] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('never runs', function(){});"] } }
          ]
        }
      ]
    },
    {
      "name": "Get user",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/users/1?verbose=true", "host": [ "{{baseUrl}}" ], "path": [ "users", "1" ], "query": [ { "key": "verbose", "value": "true" } ] },
        "header": []
      },
      "response": [
        { "name": "OK", "code": 200, "status": "OK", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": "{\"id\":1}" }
      ]
    }
  ]
}
