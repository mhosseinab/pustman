[
  {
    "context": "RequestEditor",
    "bindings": {
      "cmd-enter": "request::Send",
      "escape": "request::Cancel",
      "cmd-l": "request::FocusUrlBar"
    }
  },
  {
    "context": "ResponseViewer",
    "bindings": {
      "cmd-f": "response::Find"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-s": "workspace::Save",
      "cmd-t": "workspace::NewTab",
      "cmd-w": "workspace::CloseTab",
      "cmd-tab": "workspace::NextTab",
      "cmd-shift-tab": "workspace::PreviousTab",
      "cmd-alt-c": "workspace::ToggleConsole",
      "cmd-\\": "workspace::ToggleSidebar",
      "cmd-shift-p": "palette::Toggle",
      "cmd-p": "quick_open::Toggle"
    }
  }
]
